<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.inqudium</groupId>
    <artifactId>legatium-benchmarks</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>legatium-benchmarks</name>
    <!-- JMH benchmarks of the shared body buffer (legatium-common's BoundedByteBuffer) against
         the JDK's ByteArrayOutputStream and Spring's FastByteArrayOutputStream - the evidence
         behind the BENCH_REPORT trail in docs/assessment - and of the metrics owner's body-meter
         path (ClientLoggingMetrics). DELIBERATELY a standalone module, not
         a child of the legatium reactor: a measurement session must not change the product
         build, and `mvn verify` at the repository root must stay byte-identical with and without
         this directory. Build with `mvn -f benchmarks/pom.xml package` after `mvn -DskipTests
         install` at the root (legatium-common is not published; it is shaded into the twins,
         so the benchmarks take it from the local repository). Java sources for the same reason
         as the fuzz tests: the JMH annotation processor works without kapt. -->
    <description>JMH benchmarks of legatium-common's BoundedByteBuffer against the JDK and Spring byte-array streams, and of its metrics owner's body-meter path</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jmh.version>1.37</jmh.version>
        <legatium.version>1.1.1-SNAPSHOT</legatium.version>
        <!-- The spring-core the twins resolve through spring-boot 4.1.1 - FastByteArrayOutputStream's home. -->
        <spring-core.version>7.0.9</spring-core.version>
        <uberjar.name>benchmarks</uberjar.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The module under test, from the local repository (see the build note above). -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>legatium-common</artifactId>
            <version>${legatium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring-core.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JDK >= 23 disables annotation processing by default; JMH's BenchmarkList is
                 generated by an annotation processor, so it is re-enabled explicitly. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <proc>full</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${uberjar.name}</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
