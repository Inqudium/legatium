<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.inqudium</groupId>
        <artifactId>legatium</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>legatium-common</artifactId>
    <name>legatium-common</name>
    <description>
        Code shared by the two paradigm twins (ADR-0003). NEVER published on its
        own: each twin inlines these classes into its jar via the Maven Shade
        plugin, so consumers keep adding exactly one artifact. The twins compile
        against this module with -Xfriend-paths, which is what lets the shared
        classes stay `internal`.
    </description>

    <properties>
        <!-- Not a deliverable: the classes ship inside the twins' jars. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- MDC and the fluent logging API are the shared code's runtime surface ... -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- ... plus the @ConfigurationProperties binding of the shared properties class. spring-boot
             only (no autoconfigure): the twins bring the rest, and the shaded jars need nothing beyond
             what they declare themselves. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <!-- JUnit + AssertJ + a real MDC-capable backend (Logback) for the
             MdcScope tests, BOM-managed like in the twins. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Fuzzing: the @FuzzTest classes under src/test/java (see
             CONTRIBUTING.md); version managed by the parent. -->
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <!-- The cross-stack contract files - the ELK component template (the index half of the
             field contract the shared enum owns) and the configuration reference (bound against the
             shared properties class) - live in the repository-shared /docs; the lockstep tests read
             them from the test classpath, so the dependency is declared here in the build, not
             hidden in a relative path inside a test. A missing checkout fails at resource processing
             with a clear message, not as a contract violation. -->
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../docs</directory>
                <includes>
                    <include>client-logging-reference.yml</include>
                    <include>elk/legatium-restclient-logging-fields.component-template.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Skip repackaging - we're a library, not a standalone app -->
                </configuration>
            </plugin>
            <!-- Belt to maven.deploy.skip's suspenders: keeps this module out of
                 the Central Portal bundle when the release profile is active. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
